  "item": [
    {
      "name": "01 · Identitas API dan dokumentasi Bearer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\n\npm.test(\"HTTP 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Isi respons sesuai kontrak\", function () {\n    pm.expect(body.info.title).to.eql(\"embege\");\n    pm.expect(body.paths).to.have.property(\"/recommendations\");\n});\n\npm.test(\"OpenAPI menyatakan autentikasi Bearer untuk GET /auth/me\", function () {\n    const schemes = body.components?.securitySchemes || {};\n    const requirements = body.paths[\"/auth/me\"].get.security || body.security || [];\n\n    const bearer = Object.keys(schemes).filter(\n        k => schemes[k].scheme?.toLowerCase() === \"bearer\"\n    );\n\n    pm.expect(\n        requirements.some(r => bearer.some(k => k in r)),\n        \"Bearer terdokumentasi\"\n    ).to.eql(true);\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/openapi.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openapi.json"
          ]
        }
      },
      "response": []
    },
