    {
      "name": "09 · Katalog menu perhalaman",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nif (pm.response.code === 200) {\n    pm.test(\"Respons menu valid dan cursor tersimpan\", function () {\n        const page = pm.response.json();\n\n        pm.expect(page.items).to.be.an(\"array\");\n        pm.expect(page.has_next_page).to.be.a(\"boolean\");\n        pm.expect(page.has_previous_page).to.be.a(\"boolean\");\n\n        function cekCursor(tersedia, cursor, nama) {\n            if (tersedia) {\n                pm.expect(cursor, nama).to.be.a(\"string\").and.not.empty;\n            } else {\n                pm.expect(cursor, nama).to.equal(null);\n            }\n        }\n\n        cekCursor(page.has_next_page, page.next_cursor, \"next_cursor\");\n        cekCursor(page.has_previous_page, page.previous_cursor, \"previous_cursor\");\n\n        pm.collectionVariables.set(\"menuNextCursor\", page.next_cursor ?? \"\");\n        pm.collectionVariables.set(\"menuPreviousCursor\", page.previous_cursor ?? \"\");\n\n        pm.collectionVariables.set(\"menu1\", page.items[0]?.id ?? \"\");\n    });\n}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
