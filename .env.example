APP_ENV=development
LOG_LEVEL=INFO

# Port API di host dan di container (dipakai compose.yaml untuk command uvicorn)
API_PORT=8000
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1

DB_HOST=db
DB_PORT=5432
DB_NAME=embege
DB_USER=embege
DB_PASSWORD=

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=600
LLM_OUTPUT_MODE=text
LLM_MAX_OUTPUT_TOKENS=5120
LLM_MAX_RESPONSE_BYTES=163840
# Maksimum proses rekomendasi bersamaan, dibagi seluruh worker melalui Redis.
LLM_MAX_CONCURRENT_REQUESTS=5
CATALOG_PATH=app/data/menus.json

MAX_REGION_NAME_LENGTH=1500
MAX_GEOGRAPHIC_DESCRIPTION_LENGTH=20000
MAX_SELECTION_REASON_LENGTH=10000

RECOMMENDATION_MINUTE_LIMIT=100
RECOMMENDATION_LONG_WINDOW_LIMIT=1000
RECOMMENDATION_LONG_WINDOW_SECONDS=10800
RECOMMENDATION_LOCK_TTL_SECONDS=1200

REGISTER_LIMIT=50
REGISTER_WINDOW_SECONDS=3600
INVALID_AUTH_LIMIT=30
INVALID_AUTH_WINDOW_SECONDS=60
LOGIN_LIMIT=100
LOGIN_WINDOW_SECONDS=900
CHANGE_PASSWORD_LIMIT=50
CHANGE_PASSWORD_WINDOW_SECONDS=900
ME_LIMIT=600
ME_WINDOW_SECONDS=60
READ_LIMIT=600
READ_WINDOW_SECONDS=60

READ_MAX_PAGE_SIZE=1000

CORS_ALLOWED_ORIGINS=[]
TRUSTED_PROXY_IPS=[]
