APP_ENV=development
LOG_LEVEL=INFO

# Port API di host dan di container (dipakai compose.yaml untuk command uvicorn)
API_PORT=8000
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1

DB_HOST=db
DB_PORT=5432
DB_NAME=embege
DB_USER=embege
DB_PASSWORD=

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_OUTPUT_MODE=text
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_RESPONSE_BYTES=16384
CATALOG_PATH=app/data/menus.json

MAX_REGION_NAME_LENGTH=150
MAX_GEOGRAPHIC_DESCRIPTION_LENGTH=2000
MAX_SELECTION_REASON_LENGTH=1000

RECOMMENDATION_MINUTE_LIMIT=10
RECOMMENDATION_LONG_WINDOW_LIMIT=100
RECOMMENDATION_LONG_WINDOW_SECONDS=10800
RECOMMENDATION_LOCK_TTL_SECONDS=120

REGISTER_LIMIT=5
REGISTER_WINDOW_SECONDS=3600
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=900
CHANGE_PASSWORD_LIMIT=5
CHANGE_PASSWORD_WINDOW_SECONDS=900
ME_LIMIT=60
ME_WINDOW_SECONDS=60
READ_LIMIT=60
READ_WINDOW_SECONDS=60

READ_MAX_PAGE_SIZE=100

CORS_ALLOWED_ORIGINS=[]
TRUSTED_PROXY_IPS=[]
